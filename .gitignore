__pycache__
.venv

# Django web/ app (Issue #30) - real secrets/generated files, never commit
web/.env
web/staticfiles/
web/db.sqlite3
web/celerybeat-schedule*
wikitext-103-v1

# Issue #51 chat/base pipeline artifacts — regenerated by build_chat_checkpoint.py
hvn_chat_checkpoint.pt
hvn_chat_checkpoint_tokenizer.json
hvn_chat_smoke.pt
hvn_chat_smoke_tokenizer.json
# Issue #71 EdgeHVN ternary checkpoint artifacts â€” regenerated by train.py --edge --ternary
hvn_edge_ternary_deltanet.pt
hvn_edge_ternary_deltanet_tokenizer.json

# Issue #72 EdgeHVN conversational training artifacts — regenerated by train_edge_conversational.py
checkpoints/
data_cache/
# Claude Code — version the agent definitions (.claude/agents/) and CLAUDE.md,
# but never the local/runtime state:
#   worktrees/          live git worktrees of other branches (full repo copies)
#   settings.local.json machine-specific permission allowlist w/ absolute paths
#   *.lock              runtime locks holding live PIDs/session ids
.claude/worktrees/
.claude/settings.local.json
.claude/*.lock

# GHOST Phase 2 (#126): dense checkpoint series is a regenerable multi-GB
# intermediate (scripts/ghost harness --make-series), not a result artifact.
results/ghost/series*/

# Git-Bash-on-Windows artifact: a literal dev/null directory created when a
# hook or script redirects to /dev/null from a non-POSIX shell.
dev/null/

# Run logs — untracked working output (kept sweeping into commits via `git add -A`)
logs/
scripts/logs/

# Trained weights are never tracked (2026-08-30). They are a separate work,
# not under the repo's Apache 2.0 licence (see NOTICE), and they bloat history.
# The four that used to be tracked were untracked here; they remain on disk.
*.pt
*.pth
*.ckpt
*.safetensors
