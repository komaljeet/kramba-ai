# Copy to .env and fill in real values. Never commit the real .env file.

DJANGO_SETTINGS_MODULE=web.settings.dev
DJANGO_SECRET_KEY=change-me-to-a-random-50-char-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=kramba
POSTGRES_USER=kramba
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

REDIS_URL=redis://redis:6379/0

CORS_ALLOWED_ORIGINS=http://localhost:3000

HVN_CHECKPOINT_DIR=/data/checkpoints
CONVERSATION_RETENTION_DAYS=90

CELERY_WORKER_CONCURRENCY=1
