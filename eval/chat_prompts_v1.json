{
  "version": "chat_prompts_v1",
  "note": "FROZEN. Do not edit in place: scores are only comparable across runs on the same file (the scorer records its sha256). To change the set, copy to chat_prompts_v2.json. 'keywords' are matched case-insensitively at a word start; a reply is on-topic when at least 'min_hits' distinct keywords appear (default 1). For factual/followup prompts no keyword may appear in the final user message, so echoing the question cannot score (enforced by tests/test_chat_coherence_eval.py).",
  "prompts": [
    {"id": "fact_capital_france", "category": "factual",
     "messages": [{"role": "user", "content": "What is the capital of France?"}],
     "keywords": ["paris"]},
    {"id": "fact_spider_legs", "category": "factual",
     "messages": [{"role": "user", "content": "How many legs does a spider have?"}],
     "keywords": ["eight", "8"]},
    {"id": "fact_largest_planet", "category": "factual",
     "messages": [{"role": "user", "content": "What is the largest planet in our solar system?"}],
     "keywords": ["jupiter"]},
    {"id": "fact_romeo_author", "category": "factual",
     "messages": [{"role": "user", "content": "Who wrote Romeo and Juliet?"}],
     "keywords": ["shakespeare"]},
    {"id": "fact_plants_gas", "category": "factual",
     "messages": [{"role": "user", "content": "What gas do plants absorb from the air?"}],
     "keywords": ["carbon dioxide", "co2"]},
    {"id": "fact_boiling_point", "category": "factual",
     "messages": [{"role": "user", "content": "What is the boiling point of water in Celsius?"}],
     "keywords": ["100", "one hundred"]},
    {"id": "fact_multiply", "category": "factual",
     "messages": [{"role": "user", "content": "What is 7 times 8?"}],
     "keywords": ["56", "fifty-six", "fifty six"]},
    {"id": "fact_brazil_language", "category": "factual",
     "messages": [{"role": "user", "content": "What language is mostly spoken in Brazil?"}],
     "keywords": ["portuguese"]},
    {"id": "fact_largest_ocean", "category": "factual",
     "messages": [{"role": "user", "content": "Which ocean is the largest?"}],
     "keywords": ["pacific"]},
    {"id": "explain_sky_blue", "category": "factual",
     "messages": [{"role": "user", "content": "Why is the sky blue?"}],
     "keywords": ["scatter", "rayleigh", "wavelength"]},
    {"id": "explain_photosynthesis", "category": "factual",
     "messages": [{"role": "user", "content": "Explain what photosynthesis is in one or two sentences."}],
     "keywords": ["sunlight", "glucose", "sugar", "chlorophyll", "carbon dioxide", "oxygen"]},

    {"id": "follow_name", "category": "followup",
     "messages": [{"role": "user", "content": "My name is Priya and I live in Toronto."},
                  {"role": "assistant", "content": "Nice to meet you, Priya! Toronto is a great city."},
                  {"role": "user", "content": "What is my name?"}],
     "keywords": ["priya"]},
    {"id": "follow_city", "category": "followup",
     "messages": [{"role": "user", "content": "My name is Priya and I live in Toronto."},
                  {"role": "assistant", "content": "Nice to meet you, Priya! Toronto is a great city."},
                  {"role": "user", "content": "Which city do I live in?"}],
     "keywords": ["toronto"]},
    {"id": "follow_pets", "category": "followup",
     "messages": [{"role": "user", "content": "I have a dog named Max who is 5 and a cat named Luna who is 3."},
                  {"role": "assistant", "content": "They sound lovely!"},
                  {"role": "user", "content": "Which of my pets is older?"}],
     "keywords": ["max"]},
    {"id": "follow_tokyo", "category": "followup",
     "messages": [{"role": "user", "content": "What is the capital of Japan?"},
                  {"role": "assistant", "content": "The capital of Japan is Tokyo."},
                  {"role": "user", "content": "Roughly how many people live there?"}],
     "keywords": ["million"]},
    {"id": "follow_double", "category": "followup",
     "messages": [{"role": "user", "content": "Pick a number between 1 and 10."},
                  {"role": "assistant", "content": "7"},
                  {"role": "user", "content": "Now double it."}],
     "keywords": ["14", "fourteen"]},
    {"id": "follow_italy_food", "category": "followup",
     "messages": [{"role": "user", "content": "I'm planning a trip to Italy."},
                  {"role": "assistant", "content": "That sounds exciting! What would you like to know?"},
                  {"role": "user", "content": "What food should I try there?"}],
     "keywords": ["pasta", "pizza", "gelato", "risotto", "lasagna", "tiramisu", "spaghetti", "carbonara"]},
    {"id": "follow_moon_orbit", "category": "followup",
     "messages": [{"role": "user", "content": "Let's talk about the Moon."},
                  {"role": "assistant", "content": "Sure! The Moon is Earth's only natural satellite."},
                  {"role": "user", "content": "How long does it take to go around the Earth?"}],
