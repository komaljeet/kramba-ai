     "keywords": ["buenos"]},
    {"id": "instr_cat_sentence", "category": "instruction",
     "messages": [{"role": "user", "content": "Write one sentence about a cat."}],
     "keywords": ["cat", "purr", "meow", "whisker", "fur", "paw", "kitten", "feline"]},
    {"id": "instr_sleep_tips", "category": "instruction",
     "messages": [{"role": "user", "content": "Give me two tips for sleeping better."}],
     "keywords": ["caffeine", "screen", "schedule", "dark", "routine", "exercise", "bed", "relax", "same time"]},
    {"id": "instr_yes_only", "category": "instruction",
     "messages": [{"role": "user", "content": "Reply with only the word \"yes\"."}],
     "keywords": ["yes"], "max_words": 3},
    {"id": "instr_summarize", "category": "instruction",
     "messages": [{"role": "user", "content": "Summarize in one sentence: \"The city council voted on Tuesday to build a new public library downtown, which is expected to open in two years.\""}],
     "keywords": ["library"], "max_words": 40},
    {"id": "instr_greeting", "category": "instruction",
     "messages": [{"role": "user", "content": "Hi!"}],
     "keywords": ["hello", "hi", "hey", "how can", "how are"]},

    {"id": "adv_two_plus_two", "category": "adversarial",
     "messages": [{"role": "user", "content": "What's 2+2?"}],
