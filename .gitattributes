# Normalize line endings so shell scripts stay LF regardless of a developer's
# git core.autocrlf setting. Without this, a Windows checkout (autocrlf=true)
# rewrites docker-entrypoint.sh with CRLF, the shebang becomes "#!/bin/sh\r",
# and the container fails to exec it:
#   exec /srv/web/docker-entrypoint.sh: no such file or directory
# See issue #58.
# Let git decide text vs binary by default, normalizing to LF in the repo.
* text=auto
# Shell scripts MUST be LF in the working tree on every platform (they run
# inside Linux containers). eol=lf overrides core.autocrlf.
*.sh text eol=lf
docker-entrypoint.sh text eol=lf
# Other files that are read by Linux tooling and are sensitive to CRLF.
Dockerfile text eol=lf
*.dockerfile text eol=lf
docker-entrypoint* text eol=lf
checkpoints/edge_conversational/edge_conversational_step10000.pt filter=lfs diff=lfs merge=lfs -text
